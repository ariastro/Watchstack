CREATE TABLE RemoteListMeta (
    cache_key TEXT NOT NULL PRIMARY KEY,
    page INTEGER NOT NULL,
    has_next INTEGER NOT NULL,
    stored_at INTEGER NOT NULL
);

CREATE TABLE RemoteListItem (
    cache_key TEXT NOT NULL,
    position INTEGER NOT NULL,
    mal_id INTEGER NOT NULL,
    title TEXT NOT NULL,
    title_japanese TEXT,
    image_url TEXT,
    synopsis TEXT,
    score REAL,
    episodes INTEGER,
    status TEXT,
    airing INTEGER NOT NULL DEFAULT 0,
    rated TEXT,
    genres TEXT NOT NULL DEFAULT '',
    type TEXT,
    source TEXT,
    duration TEXT,
    rating TEXT,
    year INTEGER,
    season TEXT,
    trailer_url TEXT,
    trailer_youtube_id TEXT,
    PRIMARY KEY(cache_key, position)
);

CREATE TABLE DetailAnimeCache (
    mal_id INTEGER NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    title_japanese TEXT,
    image_url TEXT,
    synopsis TEXT,
    score REAL,
    episodes INTEGER,
    status TEXT,
    airing INTEGER NOT NULL DEFAULT 0,
    rated TEXT,
    genres TEXT NOT NULL DEFAULT '',
    type TEXT,
    source TEXT,
    duration TEXT,
    rating TEXT,
    year INTEGER,
    season TEXT,
    trailer_url TEXT,
    trailer_youtube_id TEXT,
    stored_at INTEGER NOT NULL
);

CREATE TABLE SearchHistoryEntity (
    query TEXT NOT NULL PRIMARY KEY,
    searched_at INTEGER NOT NULL
);
